{
  "schemaVersion": "2.2",
  "description": "Request an exact reviewed CoralNPU source SHA through a fixed host launcher. No arbitrary command parameters.",
  "parameters": {
    "Operation": {"type": "String", "allowedPattern": "^(Build|Cancel)$", "interpolationType": "ENV_VAR"},
    "SourceSha": {"type": "String", "allowedPattern": "^[0-9a-f]{40}$", "interpolationType": "ENV_VAR"},
    "RunId": {"type": "String", "allowedPattern": "^[1-9][0-9]{0,19}$", "interpolationType": "ENV_VAR"},
    "RunAttempt": {"type": "String", "allowedPattern": "^[1-9][0-9]{0,5}$", "interpolationType": "ENV_VAR"},
    "RequestSha256": {"type": "String", "allowedPattern": "^[0-9a-f]{64}$", "interpolationType": "ENV_VAR"},
    "RequestBase64": {"type": "String", "allowedPattern": "^[A-Za-z0-9+/]+={0,2}$", "minChars": 1, "maxChars": 12000, "interpolationType": "ENV_VAR"}
  },
  "mainSteps": [{
    "action": "aws:runShellScript",
    "name": "fixedLauncher",
    "inputs": {
      "timeoutSeconds": "22200",
      "runCommand": [
        "set -eu",
        ": \"${SSM_Operation:?ENV_VAR interpolation unavailable}\" \"${SSM_SourceSha:?}\" \"${SSM_RunId:?}\" \"${SSM_RunAttempt:?}\" \"${SSM_RequestSha256:?}\" \"${SSM_RequestBase64:?}\"",
        "test -x /usr/local/libexec/coralnpu-ci-submit",
        "exec /usr/local/libexec/coralnpu-ci-submit"
      ]
    }
  }]
}
